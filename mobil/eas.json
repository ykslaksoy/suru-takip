{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ORTAM": "gelistirme"
      }
    },
    "pilot": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ORTAM": "pilot"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ORTAM": "uretim"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
