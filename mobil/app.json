{
  "expo": {
    "name": "SürüYön",
    "slug": "suruyon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./varliklar/images/icon.png",
    "scheme": "suruyon",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.suruyon.mobile",
      "buildNumber": "1"
    },
    "android": {
      "package": "app.suruyon.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./varliklar/images/android-icon-foreground.png",
        "backgroundImage": "./varliklar/images/android-icon-background.png",
        "monochromeImage": "./varliklar/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./varliklar/images/favicon.png",
      "name": "SürüYön",
      "shortName": "SürüYön",
      "themeColor": "#2d6a4f",
      "backgroundColor": "#f4f7f0",
      "display": "standalone",
      "orientation": "portrait"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./varliklar/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#2d6a4f"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kuzu ve hayvan fotoğraflarını veterinere göndermek için galeri erişimi gerekir.",
          "cameraPermission": "Veteriner vakası için hayvan fotoğrafı çekmek üzere kamera erişimi gerekir."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
