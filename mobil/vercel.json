{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "EXPO_PUBLIC_ORTAM=uretim npx expo export -p web",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/hayvan/:id/kilo",
      "destination": "/hayvan/%5Bid%5D/kilo"
    },
    {
      "source": "/hayvan/:id/saglik",
      "destination": "/hayvan/%5Bid%5D/saglik"
    },
    {
      "source": "/hayvan/:id/dogum",
      "destination": "/hayvan/%5Bid%5D/dogum"
    },
    {
      "source": "/hayvan/:id",
      "destination": "/hayvan/%5Bid%5D"
    },
    {
      "source": "/gorevler/asi/:programId",
      "destination": "/gorevler/asi/%5BprogramId%5D"
    },
    {
      "source": "/gorevler/kategori/:id",
      "destination": "/gorevler/kategori/%5Bid%5D"
    },
    {
      "source": "/gorevler/yem/:yemId",
      "destination": "/gorevler/yem/%5ByemId%5D"
    }
  ]
}
